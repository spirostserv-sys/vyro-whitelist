# Supabase — the same project the VYRO app uses (tizrsxyzhjplysuqrumd).
# The publishable key is public by design: it already ships in the app's
# index.html, and RLS is what protects the data. The service_role key must
# never appear in this file or anywhere else in the repo.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>
